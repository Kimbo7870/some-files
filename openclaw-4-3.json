  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/glm-4.7-flash:latest"
      },
      "models": {
        "ollama/qwen2.5:0.5b": {},
        "ollama/glm-4.7-flash:latest": {},
        "ollama/qwen3.5:0.8b": {},
        "ollama/qwen3.5:9b": {},
        "ollama/granite4:3b": {},
        "ollama/ministral-3:3b": {},
        "ollama/mistral:7b": {},
        "ollama/nemotron-3-nano:latest": {},
        "ollama/nemotron-mini:latest": {},
        "ollama/gpt-oss:20b": {},
        "ollama/deepseek-r1:latest": {},
        "ollama/phi4-mini:3.8b": {},
        "ollama/phi4:14b": {},
        "ollama/gemma3:270m": {},
        "ollama/gemma3:12b": {},
        "ollama/functiongemma:latest": {},
        "ollama/lfm2:latest": {},
        "ollama/llama3.1:latest": {},
        "ollama/qwen3.5:27b": {},
        "openai/gpt-5.4": {
          "alias": "GPT"
        }
      },
      "workspace": "<REDACTED: local workspace path>",
      "timeoutSeconds": 79200
    }
  },
  "tools": {
    "profile": "coding",
    "allow": [
      "group:fs",
      "group:runtime",
      "subagents",
      "web_fetch"
    ],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": true
      }
    },
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "off",
      "notifyOnExit": true
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer",
    "threadBindings": {
      "enabled": true,
      "idleHours": 24,
      "maxAgeHours": 0
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "commands": {
        "native": true
      },
      "token": "<REDACTED: Discord bot token>",
      "groupPolicy": "allowlist",
      "streaming": "off",
      "guilds": {
        "<REDACTED: Discord server ID>": {
          "requireMention": false,
          "users": [
            "<REDACTED: Discord user ID>"
          ],
          "channels": {
            "<REDACTED: Discord channel name 1>": {
              "allow": true
            },
            "<REDACTED: Discord channel name 2>": {
              "allow": true
            },
            "<REDACTED: Discord channel name 3>": {
              "allow": true
            }
          }
        }
      },
      "execApprovals": {
        "enabled": false,
        "approvers": [
          "<REDACTED: Discord approver user ID>"
        ],
        "target": "both"
      },
      "threadBindings": {
        "enabled": true,
        "idleHours": 24,
        "maxAgeHours": 0,
        "spawnSubagentSessions": true
      },
      "inboundWorker": {
        "runTimeoutMs": 82000000
      }
    }
  },
  "gateway": {
    "port": "<REDACTED: local gateway port>",
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "<REDACTED: gateway auth token>"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send"
      ]
    }
  },
  "skills": {
    "allowBundled": [],
    "entries": {
      "coding-agent": {
        "enabled": false
      },
      "discord": {
        "enabled": true
      },
      "gemini": {
        "enabled": false
      },
      "healthcheck": {
        "enabled": false
      },
      "session-logs": {
        "enabled": false
      },
      "skill-creator": {
        "enabled": false
      },
      "tmux": {
        "enabled": false
      },
      "video-frames": {
        "enabled": false
      },
      "weather": {
        "enabled": false
      }
    }
  }
}
